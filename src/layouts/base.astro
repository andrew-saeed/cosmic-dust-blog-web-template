---
import Nav from '../partials/nav.astro'
import Search from '../partials/search.astro'
import CategoriesNav from '../partials/categories-nav.astro'
import LayoutMask from '../theme/layout-mask.astro'

interface Props {
    lang: string;
    dir: string;
}

const {lang, dir} = Astro.props
---
<style is:global>

@import "tailwindcss";

@config "../../tailwind.config.js";

@custom-variant dark (&:where(.dark, .dark *));

@theme {

    --text-sm: 0.75rem;
    --text-sm--line-height: 1.375rem;

    --text-sm-1: 0.875rem;
    --text-sm-1--line-height: 1.5rem;

    --text-base: 1rem;
    --text-base--line-height: 1.625rem;

    --text-base-1: 1.125rem;
    --text-base-1--line-height: 1.75rem;

    --text-base-2: 1.25rem;
    --text-base-2--line-height: 1.875rem;

    --text-medium: 1.375rem;
    --text-medium--line-height: 2rem;

    --text-medium-1: 1.5rem;
    --text-medium-1--line-height: 2.125rem;

    --text-medium-2: 1.875rem;
    --text-medium-2--line-height: 2.34375rem;

    --text-large: 2.25rem;
    --text-large--line-height: 2.875rem;

    --text-xlarge: 3.75rem;
    --text-large--line-height: 4.375rem;

    --color-white-light: #FEFAE0;
    --color-white-dark: #eae6cf;
    --color-black-light: #475f2b;
    --color-black-dark: #283618;
    --color-black-dim: rgb(40, 54, 24, 0.8);
    --color-green: #49C055;
    --color-red: #ff5e32;
    --color-yellow: #FFC801;
    --color-blue-light: #38bdf8;
    --color-blue-dark: #5748AE;
    --color-blue-dim: rgba(87, 72, 174, 0.8);
    --color-gray-light: #bcbcbf;
    --color-gray-dark: #9ca3af;

    --color-dark-white-light: #011222;
    --color-dark-white-light-dim: rgba(1, 18, 34, 0.9);
    --color-dark-white-dark: #94a3b8;
    --color-dark-black-dark: #1e293b;

    --breakpoint-xs: 320px;
    --breakpoint-sm: 425px;
    --breakpoint-md: 768px;
    --breakpoint-lg: 992px;
    --breakpoint-xlg: 1200px;
    --breakpoint-2xlg: 1440px;

    --shadow-base: 0px 0px 15px -5px var(--color-black-light);
}

@layer base {

    html {
        font-family: IBM Plex Sans,sans-serif;
    }

    main {
        max-width: 768px;
        padding: 5rem 0.5rem;
        margin: 0rem auto;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
        width: 0.5rem;
    }
    ::-webkit-scrollbar-thumb {
        background: var(--color-black-light);
        border-radius: 0rem;
    }
    ::-webkit-scrollbar-track {
        background-color: var(--color-white-light);
    }
    ::-webkit-scrollbar-button {
        background-color: var(--color-black-dark);
        border-radius: 0rem;
    }
    ::-webkit-scrollbar-button:hover {
        background: var(--color-black-dark);
    }
    ::-webkit-scrollbar-thumb:hover {
        background: var(--color-black-dark);
    }
    html[class=dark] {
        ::-webkit-scrollbar-thumb {
            background: var(--color-blue-dark);
        }
        ::-webkit-scrollbar-track {
            background-color: var(--color-dark-black-dark);
        }
        ::-webkit-scrollbar-button {
            background-color: var(--color-blue-dark);
        }
        ::-webkit-scrollbar-button:hover {
            background: var(--color-blue-dark);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--color-blue-dark);
        }
    }
    @supports not selector(::-webkit-scrollbar) {
    
        * {
            scrollbar-width: auto;
            scrollbar-color: var(--color-white-light) var(--color-black-dark);
            scrollbar-gutter: stable both-edges;
        }
    }
}

@layer components {

    #main-section {
        margin-top: 3rem;
    }

    .disabled {
        opacity: 0.6;
        cursor: default;
    }

    .markdown-content {

        h1 {
            font-size: 2.5rem;
            font-weight: bold;
            line-height: var(--text-large--line-height);
            text-transform: capitalize;
        }

        h2 {
            font-size: 2.25rem;
            text-transform: capitalize;
            margin: 4rem 0 1.25rem 0;
        }

        ul {
            list-style: disc;
        }
        
        p {
            font-size: 1.125rem;
        }
    }

    nav {

        .current-link {
            border: var(--color-white-light) 0.1rem solid;
    
            @media screen and (min-width:768px){
                border-top: unset;
                border-left: unset;
                border-right: unset;
            }
        }

        a {
            padding: 0.5rem;
            display: block;
            width: 100%;
            text-align: center;
            font-weight: bold;

            &:hover {
                background-color: var(--color-black-light);
            }

            html[class=dark] &:hover {
                background-color: var(--color-blue-light);
            }

            @media screen and (min-width:768px) {
                opacity: 1!important;
                transform: translateX(0)!important; 
                animation-delay: 0!important;
                animation-duration: 0!important;
            }
        }
    }

    li.category-nav-item {

        &:has(.current-category-link) {
            background: var(--color-black-light);
            color: var(--color-white-dark);
            font-weight: bold;

            html[class=dark] & {
                background: var(--color-blue-dark);
            }
        }
        &:not(:has(.current-category-link)):hover {

            .category-name {
                background-color: var(--color-white-dark);
            }

            html[class=dark] & {

                .category-name {
                    background: var(--color-blue-light);
                }
            }
        }
    }
}
</style>
<script>
    // init alpinejs
    import Alpine from 'alpinejs'

    const uiStore:UiStore = {
        layoutMask: document.querySelector<HTMLElement>('#layout-mask')!,

        showLayoutMask() {
            this.layoutMask.style.visibility = 'visible'
            this.layoutMask.style.opacity = '1'
            document.body.style.overflowY = 'hidden'
        },
        hideLayoutMask() {
            this.layoutMask.style.visibility = 'hidden'
            this.layoutMask.style.opacity = '0'
            document.body.style.overflowY = 'scroll'
        }
    }
    Alpine.store('uiStore', uiStore)
    Alpine.start()

    // init lang, dir and theme on html ele
    document.documentElement.lang = `${document.body.getAttribute('data-lang')}`
    document.documentElement.dir = `${document.body.getAttribute('data-dir')}`
    const slider = document.querySelector<HTMLElement>('#slider')!
    const cosmicDustTheme = localStorage.getItem('cosmic-dust-theme')
    if(cosmicDustTheme === 'dark') {
        document.documentElement.classList.toggle('dark')
        slider.style.transform = 'translateY(-24px)'
    }

    // linkBtns disabled will preventDefault
    const linkBtns = document.querySelectorAll<HTMLElement>('.link-btn')
    linkBtns.forEach(linkBtn => {
        linkBtn.addEventListener('click', (e)=> {
            if(linkBtn.classList.contains('disabled')) {
                e.preventDefault()
            }
        })
    })
</script>
<html>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
    <slot />

    <body data-lang={lang} data-dir={dir} class="bg-white-light dark:bg-dark-white-light text-base text-black-dark dark:text-white-light font-ibm-plex-sans">
        <LayoutMask />
        <Nav lang={lang}></Nav>
        <main>
            <Search lang={lang} />
            <CategoriesNav lang={lang} />
            <slot name="main" />
        </main>
    </body>
</html>